# Normalize text files to LF in the repo, keep platform native in the working tree.
* text=auto eol=lf

# Force LF for everything text we ship
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.db     binary
*.zip    binary
