# PyQuest configuration. Copy this file to .env and edit as needed.

# Kokoro offline TTS — voice id. See Settings for the full list.
KOKORO_VOICE=af_heart

# Auto-narrate lessons, hints, and errors (1/0).
PYQUEST_AUTOPLAY=1

# Local LLM (LM Studio). Start the server inside LM Studio first.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Proactive AI tutor: jump in automatically on wrong answers / Python errors (1/0).
PYQUEST_PROACTIVE_TUTOR=1
